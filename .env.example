# Cloudflare R2 (S3-compatible). See docs/methods/setup.md §2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=polymarket-stage1
R2_REGION=auto
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# Polymarket Gamma API
POLYMARKET_GAMMA_BASE_URL=https://gamma-api.polymarket.com

# Polygon JSON-RPC (eth_getBlockByNumber). https://polygon-rpc.com often returns 401 without a key.
# Use a provider URL you control, e.g. Alchemy: https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
# Optional comma-separated fallbacks if the first URL fails:
# POLYGON_RPC_FALLBACK_URLS=https://polygon-bor.publicnode.com,https://1rpc.io/matic
POLYGON_RPC_URL=https://polygon-bor.publicnode.com

# Widen if binary search fails (integers, no underscores)
# POLYGON_BLOCK_SEARCH_LO=56000000
# POLYGON_BLOCK_SEARCH_HI=72000000

# Analysis
SIGN_RANDOMIZATION_ITERATIONS=10000
SIGN_RANDOMIZATION_SEED=42
# Enumerate all 2^K sign vectors through K=12; use add-one Monte Carlo above it.
SIGN_RANDOMIZATION_EXACT_MAX_EVENTS=12

# DuckDB analysis window (Unix seconds on order_filled.block_timestamp). Omit both for full R2 history.
# ANALYSIS_BLOCK_TS_MIN=1727740800
# ANALYSIS_BLOCK_TS_MAX=1730332799
# Or last N calendar days from max(timestamp) in Parquet (do not combine with ANALYSIS_BLOCK_TS_*):
# ANALYSIS_USE_LAST_N_DAYS=30

# Week buckets: week_index = floor((ts - ANALYSIS_WEEK_ANCHOR_TS) / 604800).
# Train is buckets 0..2, test is bucket 3, and later rows are explicit overflow (not test).
# ANALYSIS_WEEK_ANCHOR_TS=1727740800

# Minority labels from first 3 week buckets only (requires bounded window above):
# MINORITY_LABEL_SPLIT=train_3w_test_1w

# Stage 1 primary inference excludes markets whose market or parent event ends after the last fill.
# Also applied by favorite_buying.
# PNL_MARKET_UNIVERSE=resolved_by_fill_cutoff

# classification: demote nominal Skilled accounts that fail BH at this q (eligible cohort only).
# CLASSIFICATION_FDR_Q=0.05

# OIB panel: which taker fills to include (labels still from train when split is on). Default all.
# OIB_EVAL_WEEK=all
# OIB_EVAL_WEEK=train
# OIB_EVAL_WEEK=test
# OIB_MARKET_UNIVERSE=resolved_by_fill_cutoff

# Paper Task 5 — random event train/test, dual sign + classification (separate R2 keys; orthogonal to week split).
# Uses current ``takers`` / ``ANALYSIS_*`` window. Reuses SIGN_RANDOMIZATION_* for iteration count and base seed.
# EVENT_OOS_TRAIN_FRAC=0.8
# EVENT_OOS_SEED=42
# EVENT_OOS_SEEDS=42,43,44,45,46
# EVENT_OOS_EXPORT_R2=true
# Run: python -m src.analysis.event_split_persistence
# Robustness: python -m src.analysis.event_split_robustness

# Attribute settled PnL to favorite buys, underdog buys, and sells.
# FAVORITE_ANALYSIS_WEEK=test
# FAVORITE_THRESHOLDS=0.5,0.75,0.9
# Run: python -m src.analysis.favorite_buying

# Skilled-account profile (Stage 1 FDR labels; restricted universe).
# SKILLED_PROFILE_LABEL_COL=trader_group_fdr_q05
# SKILLED_PROFILE_OUT_DIR=logs/skilled_profile
# SKILLED_PROFILE_REFRESH=0
# SKILLED_PROFILE_TOP_N=10
# SKILLED_PROFILE_MIN_SHARED_MARKETS=3
# SKILLED_PROFILE_COTIME_WINDOW_S=10
# SKILLED_PROFILE_CALIBRATED_ITER=5000
# SKILLED_PROFILE_SEED=42
# Run: python -m src.analysis.skilled_profile

# Stage 2 period-scoped R2 keys live under periods/<PERIOD_ID>/. Unset keeps Stage 1 (2024) keys.
# Stage 2 analysis of already-ingested slices:
# PERIOD_ID=recent_2026
# PNL_MARKET_UNIVERSE=resolved_by_fill_cutoff
# OIB_MARKET_UNIVERSE=resolved_by_fill_cutoff
# OIB_EVAL_WEEK=all
# STAGE2_EXCLUDE_COMBOS=1
# STAGE2_EXCLUDE_THEMES=Sports & esports,Weather & science
# After one R2 copy, analysis reads this local mirror:
# LOCAL_R2_MIRROR=data/periods/recent_2026/r2_mirror
# Run: bash scripts/run_stage2_analysis.sh
